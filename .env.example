# opcional: copiar a .env. sin este archivo el proyecto corre con estos mismos valores por defecto.

# segundos entre mensajes del producer
DELAY_SEG=1
# 0 = el producer repite los hogares de prueba sin parar
MAX_MENSAJES=0
CICLOS=0

# usuario de la interfaz de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin


# solo si hace falta forzar la versión de scikit-learn (normalmente se lee de models/modelo_pobreza_meta.json)
SKLEARN_VERSION=

# dirección de la API del IPM (la del servidor del curso)
API_URL=http://201.32.130.152/api/productos
