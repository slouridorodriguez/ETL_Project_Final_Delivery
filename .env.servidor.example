# para usar el broker compartido del servidor en vez del kafka del compose (no se sube al repositorio)
#   docker compose --env-file .env.servidor up --build --no-deps producer consumer dashboard
# en este modo no se levanta postgres: el producer lee el archivo streaming/data/eventos_prueba.csv.gz
KAFKA_BOOTSTRAP=201.32.130.152:9092
KAFKA_BOOTSTRAP_DOCKER=201.32.130.152:9092
TOPIC_FEATURES=hogares_entrena_modelo
TOPIC_PREDICCIONES=hogares_etl_resultado
TOPIC_INVALIDOS=
CREAR_TOPIC=0
OFFSET_RESET=latest
GROUP_ID=etl-g51-consumer-modelo
DESTINO_URL=
SKLEARN_VERSION=
DELAY_SEG=1
GUARDAR_PREDICCIONES=0
MAX_MENSAJES=200
CICLOS=1
ESPERAR_VISTA=0
