# Variables para correr los notebooks y el DAG en Colab o fuera de Docker (entrega 2).
# No copiar este archivo como .env si se va a usar docker compose: el compose lee .env y estos valores lo desconfigurarían.

# Base de datos de origen (primera entrega, PostgreSQL / Supabase)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/base

# Base relacional de destino (data warehouse); si no se define, se usa SQLite
DESTINO_URL=postgresql://usuario:contraseña@host:5432/base

API_URL=http://201.32.130.152/api/productos
CSV_PATH=./etl_proyecto/viviendas_pdtos.csv
MERGE_CSV=./etl_proyecto/merge_departamento.csv
ETL_BASE=./etl_proyecto
DAG_SCHEDULE=@daily
